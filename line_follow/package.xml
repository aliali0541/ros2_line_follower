<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml — ROS 2 Humble package manifest for line_follow
  Project: Line-Following Robot with ESP32 + micro-ROS
  Describes all build-time and runtime dependencies.
-->
<package format="3">
  <name>line_follow</name>
  <version>1.0.0</version>
  <description>
    ROS 2 Humble package for a differential-drive line-following robot.
    Includes PID controller, obstacle avoidance state machine,
    lap monitor, and trajectory plotting. Communicates with an
    ESP32 via micro-ROS over WiFi (UDP).
  </description>

  <!-- Maintainer contact — change to your info -->
  <maintainer email="student@university.edu">Student Name</maintainer>
  <license>MIT</license>

  <!-- ── Build tool ────────────────────────────────────────────── -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ── Runtime: ROS 2 Python client library ─────────────────── -->
  <depend>rclpy</depend>

  <!-- ── Message / service packages ───────────────────────────── -->
  <!-- Standard primitive messages (Bool, Float32, String …) -->
  <depend>std_msgs</depend>

  <!-- geometry_msgs/Twist used for /cmd_vel -->
  <depend>geometry_msgs</depend>

  <!-- nav_msgs/Odometry used for /odom -->
  <depend>nav_msgs</depend>

  <!-- sensor_msgs — future IMU / LaserScan support -->
  <depend>sensor_msgs</depend>

  <!-- ── Launch system ─────────────────────────────────────────── -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ── Test dependencies ─────────────────────────────────────── -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ── Ament export ───────────────────────────────────────────── -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
